{
  "headers": [
    {
      "source": "/(.*).(js|css|svg|json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(png|jpg|jpeg|webp|avif|gif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.usaghostwriter.com"
        }
      ],
      "destination": "https://usaghostwriter.com/:path*",
      "permanent": true
    }
  ]
}
